# Discord Bot Tokens
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_TOKEN_DEV=your_dev_bot_token_here

# LLM Provider — "anthropic" | "openai" | "deepseek"
LLM_PROVIDER=anthropic
# Optional model override. Leave empty to use the provider's default.
LLM_MODEL=

# LLM API Keys (fill in the one for your provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Book Metadata
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Bot Environment: prod (default) or dev. dev uses DISCORD_TOKEN_DEV when set.
ENV=prod
# Optional. Default is the newest CHANGELOG.md date heading. Leave unset.
# APP_VERSION=2026-08-31
# Master switch for curated, member-facing CHANGELOG announcements. Defaults to false.
RELEASE_ANNOUNCEMENTS_ENABLED=false
# Channel name for announcements after the master switch is enabled.
RELEASE_ANNOUNCEMENTS_CHANNEL=book-bot

# Admin Discord ID (optional — for injection and LLM service alerts)
ADMIN_DISCORD_ID=your_discord_user_id_here
# Suppress duplicate authentication, billing, quota, and rate-limit alerts for this many minutes.
LLM_ALERT_COOLDOWN_MINUTES=720

# Member enrollment
OPT_IN_WELCOME_CHANNEL=book-bot
